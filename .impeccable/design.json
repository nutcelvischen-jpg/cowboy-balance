  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Entry, calibration, or retry action.",
      "html": "<button class=\"ds-primary\">啟用手機傾斜</button>",
      "css": ".ds-primary{font-family:-apple-system, BlinkMacSystemFont, \"Noto Sans TC\", \"PingFang TC\", sans-serif;cursor:pointer;width:100%;min-height:56px;border:0;border-radius:12px;background:var(--yellow,#ffd76b);color:var(--ink,#30261e);font-size:17px;font-weight:800;box-shadow:0 6px 16px #071e2055}.ds-primary:hover{background:#ffe49a}.ds-primary:active{transform:translateY(2px)}.ds-primary:focus-visible{outline:3px solid var(--paper,#fff0cc);outline-offset:4px}.ds-primary:disabled{cursor:default;opacity:.45}.ds-primary{transition:background .15s,transform .15s}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Resume action",
      "kind": "button",
      "refersTo": "button-resume",
      "description": "Yellow action on the pause scrim.",
      "html": "<div class=\"ds-pause\"><button class=\"ds-resume\">繼續挑戰</button></div>",
      "css": ".ds-resume{font-family:-apple-system, BlinkMacSystemFont, \"Noto Sans TC\", \"PingFang TC\", sans-serif;cursor:pointer;width:100%;min-height:56px;border:0;border-radius:12px;background:var(--yellow,#ffd76b);color:var(--ink,#30261e);font-size:17px;font-weight:800;box-shadow:0 6px 16px #071e2055}.ds-resume:hover{background:#ffe49a}.ds-resume:active{transform:translateY(2px)}.ds-resume:focus-visible{outline:3px solid var(--paper,#fff0cc);outline-offset:4px}.ds-resume:disabled{cursor:default;opacity:.45}.ds-pause{background:rgba(17,46,48,.97);padding:24px}.ds-resume{transition:background .15s,transform .15s}@media(prefers-reduced-motion:reduce){.ds-resume{transition:none}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Underlined fallback or alternate control mode.",
      "html": "<div class=\"ds-deck\"><button class=\"ds-secondary\">先用觸控／方向鍵試玩</button></div>",
      "css": ".ds-secondary{font-family:-apple-system, BlinkMacSystemFont, \"Noto Sans TC\", \"PingFang TC\", sans-serif;cursor:pointer;display:block;width:100%;min-height:44px;border:0;background:transparent;color:#e1cfaa;text-decoration:underline;text-underline-offset:4px;font-size:12px}.ds-secondary:hover{color:var(--paper,#fff0cc)}.ds-secondary:focus-visible{outline:3px solid var(--yellow,#ffd76b);outline-offset:4px}.ds-secondary:disabled{cursor:default;opacity:.45}.ds-deck{background:var(--deck,#183c3e);padding:12px}"
    },
    {
      "name": "Icon control",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Pause and sound controls; this preview shows pause.",
      "html": "<button class=\"ds-icon\" aria-label=\"暫停遊戲\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M8 5v14M16 5v14\"/></svg></button>",
      "css": ".ds-icon{font-family:-apple-system, BlinkMacSystemFont, \"Noto Sans TC\", \"PingFang TC\", sans-serif;cursor:pointer;display:grid;place-items:center;width:44px;height:44px;background:#193e41;border:1px solid #718d89;color:var(--paper,#fff0cc);border-radius:50%}.ds-icon:hover{background:#326267}.ds-icon:focus-visible{outline:3px solid #ffd76b;outline-offset:4px}.ds-icon[aria-pressed=\"true\"]{color:#e4af71}.ds-icon:disabled{cursor:default;opacity:.45}.ds-icon svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}"
    },
    {
      "name": "Touch control",
      "kind": "button",
      "refersTo": "button-touch",
      "description": "Hold to move the rider left or right.",
      "html": "<button class=\"ds-touch\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m14 5-7 7 7 7\"/></svg>向左</button>",
      "css": ".ds-touch{font-family:-apple-system, BlinkMacSystemFont, \"Noto Sans TC\", \"PingFang TC\", sans-serif;cursor:pointer;min-width:88px;min-height:58px;border:1px solid #768d7e;border-radius:12px;background:#285052;display:flex;justify-content:center;align-items:center;color:var(--paper,#fff0cc);font-weight:800;touch-action:none;user-select:none}.ds-touch:active,.ds-touch.held{background:var(--yellow,#ffd76b);color:var(--ink,#30261e)}.ds-touch:focus-visible{outline:3px solid var(--yellow,#ffd76b);outline-offset:4px}.ds-touch svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}"
    },
    {
      "name": "Balance meter",
      "kind": "custom",
      "refersTo": "balance-meter",
      "description": "Static centered preview of the live balance indicator.",
      "html": "<div class=\"ds-meter\" role=\"meter\" aria-label=\"牛仔左右重心\" aria-valuemin=\"-100\" aria-valuemax=\"100\" aria-valuenow=\"0\"><span class=\"ds-safe\"></span><span class=\"ds-center\"></span><span class=\"ds-ticks\"></span><span class=\"ds-pin\"></span></div>",
      "css": ".ds-meter{box-sizing:border-box;height:16px;border-radius:8px;background:#955137;border:2px solid #092d30;position:relative;margin:8px 0}.ds-safe{position:absolute;left:30%;width:40%;top:0;bottom:0;background:#629675;border-radius:3px}.ds-center{position:absolute;left:50%;top:0;bottom:0;width:1px;background:#e6d7ae}.ds-pin{box-sizing:border-box;position:absolute;top:-5px;left:50%;width:10px;height:22px;background:#fff5df;border:2px solid #30261e;border-radius:4px;box-shadow:0 2px 5px #0005;transform:translateX(-50%)}.ds-meter[data-danger=\"true\"]{background:#b43826}.ds-ticks{position:absolute;inset:3px 10%;border-left:1px solid #fff0cc80;border-right:1px solid #fff0cc80}"
    },
    {
      "name": "Warning cue",
      "kind": "custom",
      "refersTo": "warning-cue",
      "description": "Directional announcement before a buck.",
      "html": "<div class=\"ds-cue\">準備往右甩！</div>",
      "css": ".ds-cue{font-family:-apple-system, BlinkMacSystemFont, \"Noto Sans TC\", \"PingFang TC\", sans-serif;display:inline-block;background:#fff0cc;color:#822715;padding:10px 18px;border-radius:8px;font-size:15px;font-weight:800;white-space:nowrap;box-shadow:0 5px 14px #00000026}"
    },
    {
      "name": "Score groups",
      "kind": "custom",
      "refersTo": "score-compact",
      "description": "Separate score backings at every viewport size; this preview shows compact height.",
      "html": "<div class=\"ds-score\"><div class=\"ds-score-time\"><span>存活時間</span><strong>0.0<small>秒</small></strong></div><p>最佳 0.0 秒<span class=\"ds-level\">熱身牛仔</span></p></div>",
